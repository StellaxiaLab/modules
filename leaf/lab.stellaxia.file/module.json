{
  "schemaVersion": 2,
  "id": "lab.stellaxia.file",
  "name": "Terra File",
  "version": "0.3.1",
  "kind": "service",
  "description": "Shared-folder listing and, from F3, resumable chunked file transfer. The second core-slimming extraction after lab.stellaxia.io-inventory.",
  "compatibility": {
    "products": ["leaf"],
    "os": ["linux", "windows"]
  },
  "entrypoints": {
    "process": {
      "linux-amd64": "bin/linux-amd64/terra-file",
      "linux-arm64": "bin/linux-arm64/terra-file",
      "windows-amd64": "bin/windows-amd64/terra-file.exe"
    },
    "scene": "scene/scene.json"
  },
  "provides": {
    "capabilities": [
      { "id": "lab.stellaxia.file", "version": "0.1.0" }
    ]
  },
  "contracts": {
    "api": "contracts/api/terra-api.json"
  },
  "contributions": {
    "gui": {
      "scenes": [
        { "id": "lab.stellaxia.file.ui", "entry": "scene/scene.json", "role": "application", "branch": "dev" }
      ],
      "apps": [
        {
          "id": "lab.stellaxia.file.web",
          "name": "Terra File",
          "mode": "static",
          "entry": "ui/index.html",
          "isolation": "sandboxed",
          "embed": "scene",
          "permissions": ["session.identity", "node.read", "file.read", "file.write"]
        }
      ]
    }
  },
  "permissions": {
    "storage": ["module-data", "shared-roots"]
  },
  "readiness": {
    "operationId": "lab.stellaxia.file.roots.list",
    "versionRange": ">=0.1.0 <1.0.0",
    "timeoutMs": 15000
  },
  "update": {
    "strategy": "start-before-stop",
    "drainTimeoutMs": 30000,
    "rollback": true
  }
}
