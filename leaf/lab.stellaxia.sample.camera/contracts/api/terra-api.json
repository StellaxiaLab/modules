    "version": "0.1.0",
    "kind": "module",
    "products": [
      "leaf",
      "tree"
    ],
    "hostRoles": [
      "leaf-node",
      "tree-control"
    ],
    "moduleId": "lab.stellaxia.sample.camera",
    "ownership": {
      "source": "module/common/lab.stellaxia.sample.camera",
      "team": "terra-platform"
    }
  },
  "authentication": {
    "workload-identity": {
      "type": "workload-identity",
      "description": "Module Runtime이 실행 instance에 발급한 단기 Workload Identity를 사용합니다."
    }
  },
