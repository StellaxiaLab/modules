    "io.terra.fleet.slots.delete": {
      "version": "0.1.0",
      "status": "stable",
      "title": "자리 삭제",
      "summary": "자리(slot)를 삭제한다 — 멤버 등록을 끝내는 유일한 명시적 이벤트.",
      "description": "연결된 daemon에 등록 해제를 통지하고 노드를 삭제한 뒤 자리를 은퇴시키고 그 자리의 코드를 폐기한다. 꺼져 있기만 한 컨테이너의 자리는 이 이벤트 없이는 사라지지 않는다.",
      "category": "fleet",
      "tags": [
        "fleet",
        "slot",
        "dangerous"
      ],
      "availability": {
        "products": [
          "tree"
        ],
        "hostRoles": [
          "tree-control"
        ],
        "scopes": [
          "cluster"
        ],
        "requiresProviderState": "ready"
      },
      "security": {
        "authentication": [
          "workload-identity"
        ],
        "permissions": [
          "node.control"
        ],
        "dataClassification": "confidential",
        "audit": {
          "required": true
        }
      },
      "input": {
        "schema": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "output": {
        "mode": "immediate",
        "schema": {
          "type": "object",
          "required": [
            "slot_id",
            "fleet_id",
            "node_deleted"
          ],
          "properties": {
            "slot_id": {
              "type": "string"
            },
            "fleet_id": {
              "type": "string"
            },
            "node_id": {
              "type": "string"
            },
            "node_deleted": {
              "type": "boolean"
            }
          }
        }
      },
      "execution": {
        "risk": "dangerous",
        "idempotency": {
          "mode": "idempotent"
        },
        "confirmation": {
          "mode": "required"
        },
        "timeoutMs": {
          "default": 5000,
          "maximum": 15000
        },
        "cancellation": "before-dispatch",
        "retry": {
          "mode": "never",
          "maximumAttempts": 1,
          "backoff": "none"
        },
        "concurrency": {
          "mode": "serial"
        }
      },
      "bindings": [
        {
          "type": "gateway-http",
          "path": "/api/modules/io.terra.fleet/v1/fleets/{fleet_id}/slots/{slot_id}",
