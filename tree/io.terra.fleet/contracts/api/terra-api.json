          "successStatus": 200
        }
      ],
      "errors": [
        "FLEET_PRINCIPAL_REQUIRED",
        "FLEET_NOT_FOUND",
        "FLEET_CORE_UNAVAILABLE"
      ]
    },
    "io.terra.fleet.codes.list": {
      "version": "0.1.0",
      "status": "stable",
