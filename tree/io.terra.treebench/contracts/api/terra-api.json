{
  "$schema": "https://schemas.terra.dev/contracts/api/v1/contract.schema.json",
  "$id": "https://contracts.terra.dev/io.terra.treebench/terra-api.json",
  "schemaVersion": "1.0.0",
  "contractId": "io.terra.treebench.api",
  "contractVersion": "0.1.0",
  "defaultLocale": "ko",
  "title": "Treebench API",
  "summary": "Tree 테스트 콘솔의 서버 절반 — 상태와 머신 채널 중계.",
  "description": "Treebench UI는 Gateway가 서빙하는 sandboxed 정적 앱이므로 사용자 세션으로 부를 수 있는 표면만 직접 호출한다. Master 계약의 device-token·service-credential 표면 15개는 브라우저 세션으로 도달할 수 없어, 이 프로세스가 자격을 받아 대신 호출하고 응답을 그대로 돌려준다.",
  "provider": {
    "id": "io.terra.treebench",
    "name": "Treebench",
    "version": "0.1.0",
    "kind": "module",
    "products": ["tree"],
    "hostRoles": ["tree-control"],
    "moduleId": "io.terra.treebench",
    "ownership": {
      "source": "module/tree/io.terra.treebench",
      "team": "terra-platform"
    }
  },
  "authentication": {
    "workload-identity": {
      "type": "workload-identity",
      "description": "Gateway가 포워딩 시 부착하는 워크로드 크리덴셜."
    }
  },
  "errors": {
    "INVALID_REQUEST": {
      "title": "중계할 수 없는 요청",
      "description": "중계 요청의 형태가 올바르지 않다. 본문을 읽을 수 없거나, path가 /api/v1/ 로 시작하지 않거나, 주어진 값으로 Master 요청을 구성할 수 없는 경우다.",
      "retryable": false,
      "httpStatus": 400,
      "userAction": "method·path·channel·credential을 확인하고 다시 보내십시오. path는 /api/v1/ 아래의 Master 경로여야 합니다."
    },
    "SERVICE_UNAVAILABLE": {
      "title": "Master에 도달할 수 없음",
      "description": "중계 대상 Master에 요청을 보내지 못했거나 응답을 읽지 못했다. 중계 대상 operation이 실행됐는지는 이 오류만으로 알 수 없다.",
      "retryable": true,
      "httpStatus": 503,
      "userAction": "Master가 떠 있는지와 모듈의 중계 대상 origin을 status로 확인한 뒤 다시 시도하십시오."
    }
  },
  "operations": {
    "io.terra.treebench.status.get": {
      "version": "0.1.0",
      "status": "stable",
      "title": "Treebench 상태",
      "summary": "테스트 콘솔 모듈의 버전과 가동 상태를 반환한다.",
      "description": "모듈 프로세스가 살아 있는지와 그 버전, 그리고 머신 채널 중계가 향하는 Master origin을 확인하는 read-only 오퍼레이션이다.",
      "category": "treebench",
      "tags": ["treebench", "read"],
      "useCases": [
        "Module Runtime이 readiness probe로 Treebench 모듈 상태를 확인한다.",
        "UI가 머신 채널 중계의 대상 Master origin을 표시한다."
      ],
      "availability": {
        "products": ["tree"],
        "hostRoles": ["tree-control"],
        "scopes": ["local"],
        "requiresProviderState": "ready"
      },
      "security": {
        "authentication": ["workload-identity"],
        "permissions": [],
        "workloadPermissions": [],
        "dataClassification": "internal",
        "audit": { "required": false }
      },
      "input": {
        "schema": { "type": "object", "additionalProperties": false },
        "examples": [
          { "name": "빈 요청", "description": "status 조회는 입력이 없다.", "value": {} }
        ]
      },
      "semantics": {
        "preconditions": [],
        "processing": [
          {
            "id": "read-status",
            "description": "모듈의 현재 상태와 버전, 중계 대상 origin을 조회한다.",
            "transaction": "none"
          }
        ],
        "postconditions": [],
        "sideEffects": []
      },
      "output": {
        "mode": "immediate",
        "schema": {
          "type": "object",
          "required": ["status", "version"],
          "properties": {
            "status": { "type": "string", "title": "상태", "description": "모듈의 현재 상태입니다." },
            "version": { "type": "string", "title": "버전", "description": "모듈의 semantic 버전입니다.", "minLength": 1 },
            "started_at": { "type": "string", "title": "기동 시각", "description": "모듈 프로세스가 기동한 시각입니다." },
            "master_url": { "type": "string", "title": "Master origin", "description": "머신 채널 중계가 요청을 보내는 Master origin입니다." }
          },
          "additionalProperties": false
        },
        "examples": [
          { "name": "정상", "value": { "status": "ok", "version": "0.1.0", "master_url": "http://127.0.0.1:8080" } }
        ]
      },
      "execution": {
        "risk": "read",
        "idempotency": { "mode": "safe" },
        "confirmation": { "mode": "none" },
        "timeoutMs": { "default": 2000, "maximum": 5000 },
        "cancellation": "before-dispatch",
        "retry": { "mode": "safe-only", "maximumAttempts": 3, "backoff": "exponential" },
        "concurrency": { "mode": "unlimited" }
      },
      "bindings": [
        {
          "type": "gateway-http",
          "method": "GET",
          "path": "/api/modules/io.terra.treebench/v1/status",
          "successStatus": 200
        }
      ],
      "authoring": {
        "studioVisible": false,
        "functionNode": false,
        "group": "Status/Health",
        "recommendedLabel": "Treebench 상태",
        "keywords": ["status", "treebench"],
        "outputPorts": [
          { "name": "status", "pointer": "/status" },
          { "name": "version", "pointer": "/version" }
        ]
      },
      "errors": []
    },
    "io.terra.treebench.machine.invoke.post": {
      "version": "0.1.0",
      "status": "stable",
      "title": "머신 채널 중계 호출",
      "summary": "device-token 또는 service-credential 표면을 테스터가 준 자격으로 대신 호출한다.",
      "description": "Master 계약의 15개 operation은 데몬(device-token)과 동거 Gateway(service-credential)만 부를 수 있어, sandboxed 브라우저 앱의 사용자 세션으로는 도달할 수 없다. 이 오퍼레이션은 테스터가 입력한 자격을 그 호출에만 사용해 Master로 요청을 보내고, 상태 코드와 본문을 가공 없이 돌려준다. 자격은 저장하지도 기록하지도 않는다.",
      "category": "treebench",
      "tags": ["treebench", "relay", "test"],
      "useCases": [
        "테스터가 데몬 흉내로 transport observed 보고를 올려 Master의 수신 경로를 확인한다.",
        "테스터가 게이트웨이 흉내로 introspect를 호출해 세션 토큰의 유효성을 검증한다."
      ],
      "availability": {
        "products": ["tree"],
        "hostRoles": ["tree-control"],
        "scopes": ["local"],
        "requiresProviderState": "ready"
      },
      "security": {
        "authentication": ["workload-identity"],
        "permissions": [],
        "workloadPermissions": [],
        "dataClassification": "confidential",
        "audit": { "required": true }
      },
      "input": {
        "schema": {
          "type": "object",
          "required": ["method", "path", "channel", "credential"],
          "properties": {
            "method": {
              "type": "string",
              "title": "HTTP 메서드",
              "description": "Master로 보낼 요청의 메서드입니다.",
              "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
            },
            "path": {
              "type": "string",
              "title": "요청 경로",
              "description": "Master의 절대 경로입니다. /api/v1 로 시작해야 하며 호스트를 포함할 수 없습니다.",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "title": "인증 채널",
              "description": "자격을 어느 헤더로 실을지 정합니다.",
              "enum": ["device", "service"]
            },
            "credential": {
              "type": "string",
              "title": "자격",
              "description": "이 호출에만 쓰이는 device token 또는 service credential입니다. 저장하지 않습니다.",
              "minLength": 1
            },
            "body": {
              "type": "object",
              "title": "요청 본문",
              "description": "body를 받는 메서드에 실어 보낼 JSON 본문입니다."
            }
          },
          "additionalProperties": false
        },
        "examples": [
          {
            "name": "데몬 흉내 — 노드 조회",
            "description": "device token으로 데몬 표면을 호출한다.",
            "value": {
              "method": "GET",
              "path": "/api/v1/daemon/nodes/leaf-a1",
              "channel": "device",
              "credential": "dev_…"
            }
          }
        ]
      },
      "semantics": {
        "preconditions": [
          {
            "id": "path-is-master-api",
            "title": "Master 경로 제한",
            "description": "path는 /api/v1 로 시작하는 Master 경로여야 한다.",
            "kind": "input",
            "enforcedBy": "provider",
            "onFailure": "INVALID_REQUEST"
          }
        ],
        "processing": [
          {
            "id": "forward",
            "description": "주어진 자격을 채널에 맞는 헤더로 실어 Master에 요청을 보낸다.",
            "transaction": "none"
          }
        ],
        "postconditions": [],
        "sideEffects": [
          {
            "resourceId": "io.terra.treebench.machine",
            "action": "external-call",
            "description": "중계 대상 operation이 가진 부수효과가 그대로 일어난다."
          }
        ]
      },
      "output": {
        "mode": "immediate",
        "schema": {
          "type": "object",
          "required": ["status", "body"],
          "properties": {
            "status": { "type": "integer", "title": "상태 코드", "description": "Master가 답한 HTTP 상태 코드입니다." },
            "body": { "type": "string", "title": "응답 본문", "description": "Master가 답한 본문 원문입니다." },
            "duration_ms": { "type": "integer", "title": "소요 시간", "description": "요청에서 응답까지 걸린 밀리초입니다." }
          },
          "additionalProperties": false
        },
        "examples": [
          { "name": "정상", "value": { "status": 200, "body": "{\"ok\":true}", "duration_ms": 7 } }
        ]
      },
      "execution": {
        "risk": "write",
        "idempotency": { "mode": "none" },
        "confirmation": { "mode": "none" },
        "timeoutMs": { "default": 15000, "maximum": 30000 },
        "cancellation": "before-dispatch",
        "retry": { "mode": "never", "maximumAttempts": 1, "backoff": "none" },
        "concurrency": { "mode": "unlimited" }
      },
      "bindings": [
        {
          "type": "gateway-http",
          "method": "POST",
          "path": "/api/modules/io.terra.treebench/v1/machine/invoke",
          "successStatus": 200
        }
      ],
      "authoring": {
        "studioVisible": false,
        "functionNode": false,
        "group": "Test/Relay",
        "recommendedLabel": "머신 채널 중계",
        "keywords": ["relay", "device", "service", "test"],
        "outputPorts": [
          { "name": "status", "pointer": "/status" },
          { "name": "body", "pointer": "/body" }
        ]
      },
      "errors": ["INVALID_REQUEST", "SERVICE_UNAVAILABLE"]
    }
  }
}
