+++ b/src/api/enroll.js
@@ -0,0 +1,153 @@
+// 미등록 노드 등록 (A-19 · Terra ADR-GW-002) — 일회용 등록 코드를 Daemon에 넘긴다.
+//
+// tree 관리자가 Master에서 코드를 만들고(`terra.master.nodes.enroll-codes.post`), 사람이 그 코드를
+// 이 기계로 들고 와 여기에 붙여 넣는다. 이 기계의 브라우저에 Master 계정 비밀번호가 가지 않는 것이
+// 요점이다 — 기존 `terra.daemon.enrollment.register.post`는 사람의 Master access token을 받으므로
+// 그 길로는 피할 수 없었다.
+//
+// 미등록 leaf의 Gateway는 **이 op 하나만** 루프백에서 통과시킨다(등록 전 창). 다섯 조건이 모두
+// 참이어야 하고(그 op · 루프백 · 미등록 · 전용 속도 제한 · 성공 1회), 조건은 Gateway가 판정한다 —
+// 아래 isLoopbackHost는 폼을 **보일지** 정하는 것뿐이고, 실제 판정은 언제나 서버 쪽이다.
+import { ENROLL } from './operations.js';
+
+/** 코드 접두사. Fleet 가입 코드(tjc_)는 이 길이 아니다 */
+export const CODE_PREFIX = 'tnc_';
+
+/**
+ * 붙여 넣은 코드를 Daemon이 받는 모양으로 본다.
+ *   tnc_<secret>                       주소 없음 → Master 주소를 따로 받아야 한다
+ *   tnc_<secret>.<base64url(origin)>   주소를 품었다 → 주소 칸을 보이지 않는다
+ * 첫 '.'이 유일한 경계다(base64url도 secret도 '.'을 쓰지 않는다).
+ * @param {string} raw
+ * @returns {{ ok: boolean, code: string, masterUrl: string, why?: string }}
+ */
+export function readCode(raw) {
+  const text = String(raw || '').trim();
+  if (!text) return { ok: false, code: '', masterUrl: '', why: '등록 코드를 붙여 넣으세요' };
+  const i = text.indexOf('.');
+  const code = i < 0 ? text : text.slice(0, i);
+  let masterUrl = '';
+  if (i >= 0) {
+    try {
+      const b = text.slice(i + 1).replace(/-/g, '+').replace(/_/g, '/');
+      const decoded = atob64(b + '==='.slice((b.length + 3) % 4));
+      if (/^https?:\/\//i.test(decoded)) masterUrl = decoded.replace(/\/$/, '');
+    } catch { /* 망가진 주소 — 코드만 쓴다. 주소는 거드는 것이고 코드가 자격이다 */ }
+  }
+  if (/^tjc_/.test(code)) return { ok: false, code: '', masterUrl: '', why: '이것은 Fleet 가입 코드(tjc_)입니다 — 노드 등록 코드(tnc_)가 필요합니다' };
+  if (code.indexOf(CODE_PREFIX) !== 0 || code === CODE_PREFIX) return { ok: false, code: '', masterUrl: '', why: '등록 코드는 ' + CODE_PREFIX + '로 시작합니다 — 복사한 것을 다시 확인하세요' };
+  return { ok: true, code, masterUrl };
+}
+
+/** base64 풀기 — 브라우저의 atob, 연동 시험(Node)의 전역 atob 둘 다 쓴다 */
+function atob64(b) {
+  if (typeof globalThis.atob === 'function') return globalThis.atob(b);
+  throw new Error('no base64 decoder');
+}
+
+/** 루프백 host 인가 — 127.0.0.0/8 · ::1 · localhost */
+export function isLoopbackHost(host) {
+  const h = String(host || '').trim().toLowerCase().replace(/^\[|\]$/g, '');
+  if (!h) return false;
+  if (h === 'localhost' || /\.localhost$/.test(h)) return true;
+  if (h === '::1' || h === '0:0:0:0:0:0:0:1') return true;
+  return /^127(\.\d{1,3}){3}$/.test(h);
+}
+
+/**
+ * 등록 요청이 Gateway에 **루프백으로** 닿는가 — 폼을 보일지 정한다.
+ * 설정의 gateway가 절대 주소면 그 host를, 경로('/gw')면 이 페이지의 host를 본다.
+ * 역방향 프록시가 사이에 있으면 이 판정이 맞아도 Gateway는 거절할 수 있다 — 그래서 서버의
+ * 403도 사람 말로 가른다(FORM 아래 submitEnroll).
+ * @param {string} gateway public/config.json 의 gateway
+ */
+export function enrollReachesLoopback(gateway, pageHost) {
+  const g = String(gateway || '').trim();
+  if (/^[a-z]+:\/\//i.test(g)) {
+    try { return isLoopbackHost(new URL(g).hostname); } catch { return false; }
+  }
+  // 같은 출처 경로('/gw')거나 ':8788' 같은 꼴 — 이 페이지가 어디서 열렸는지가 기준이다
+  const host = pageHost != null ? pageHost : (globalThis.location && globalThis.location.hostname) || '';
+  return isLoopbackHost(host);
+}
+
+/** 거절 이유를 사람 말로. 코드는 Master가 판정한 것을 Daemon이 그대로 옮긴 것이다 */
+const SAY = {
+  ENROLL_CODE_INVALID: '등록 코드가 맞지 않습니다 — 복사한 것을 다시 확인하거나 tree 관리자에게 새 코드를 받으세요',
+  ENROLL_CODE_USED: '이미 쓴 등록 코드입니다 — 코드는 한 번만 쓸 수 있습니다. tree 관리자에게 새 코드를 받으세요',
