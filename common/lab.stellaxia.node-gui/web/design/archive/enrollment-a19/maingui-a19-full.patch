+  if (r.kind === 'ok' || r.kind === 'accepted') return { ok: true, data: r.data || {} };
+  const said = SAY[r.code];
+  if (said) return { ok: false, code: r.code, msg: said, needAddr: r.code === 'ENROLL_MASTER_URL_REQUIRED' };
