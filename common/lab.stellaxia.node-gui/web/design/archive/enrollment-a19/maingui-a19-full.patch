+    return { ok: false, code: r.code || 'FORBIDDEN',
+      msg: '이 Gateway가 등록 요청을 막았습니다 — 등록은 그 기계에서, 루프백 주소(127.0.0.1)로 열어야 합니다. '
+        + '이미 등록이 한 번 성공했다면 이 창은 닫혀 있습니다 (' + (r.code || '403') + ')' };
+  }
+  if (r.kind === 'unavailable') {
+    return { ok: false, code: r.code || 'NOT_FOUND',
+      msg: '이 Gateway엔 등록 코드로 등록하는 길이 없습니다 — Terra가 더 오래된 판입니다. `terra daemon enroll`이나 설치 마법사로 등록하세요' };
+  }
+  if (r.kind === 'down' || r.kind === 'unreachable') {
+    return { ok: false, code: r.code || r.kind, msg: 'Master에 닿지 못했습니다 — 주소와 Master 상태를 확인하세요' + (r.reason ? ' (' + r.reason + ')' : '') };
+  }
+  if (r.kind === 'unauthenticated') {
+    // 401이지만 SAY에 없는 코드 — 낡은 Master가 Fleet 거절(UNAUTHORIZED)로 답한 경우가 이것이다
+    return { ok: false, code: r.code || 'UNAUTHORIZED',
+      msg: 'Master가 코드를 받지 않았습니다 — Master가 노드 등록 코드를 모르는 더 오래된 판일 수 있습니다 (' + (r.code || '401') + ')' };
+  }
+  return { ok: false, code: r.code || r.kind, msg: '등록하지 못했습니다 — ' + (r.reason || r.code || r.kind) };
+}
+
+/**
+ * 등록이 끝난 뒤 Gateway가 Master 인증으로 다시 뜨기를 기다린다.
+ * Daemon이 자기를 다시 띄우므로 Gateway도 함께 죽고 돌아온다 — 설정 화면의 재시작 대기와 같은 방식:
+ * 한 번 닿지 않게 된 뒤 다시 닿고, 그때 auth.mode가 none이 아니면 끝이다.
+ * @param {() => Promise<import('./client.js').Result>} readHealth
+ * @param {(text: string) => void} [say]
+ * @param {{ waitMs?: number, everyMs?: number, sleep?: (ms: number) => Promise<void> }} [opts]
+ */
+export async function waitForEnrolledGateway(readHealth, say, opts = {}) {
+  const waitMs = opts.waitMs || 180000, everyMs = opts.everyMs || 2000;
+  const nap = opts.sleep || ((ms) => new Promise((ok) => setTimeout(ok, ms)));
+  const t0 = Date.now();
+  let gone = false;
+  while (Date.now() - t0 < waitMs) {
+    await nap(everyMs);
+    const h = await readHealth();
+    if (h.kind !== 'ok') { gone = true; if (say) say('Daemon이 다시 뜨는 중입니다 — 기다리세요…'); continue; }
+    const a = (h.data && h.data.auth) || {};
+    if (a.mode && a.mode !== 'none') return { ok: true, mode: a.mode };
+    if (a.reason && a.reason !== 'NODE_NOT_ENROLLED') return { ok: true, mode: a.mode || 'none', reason: a.reason };
+    if (say) say(gone ? '돌아왔습니다 — Master 인증을 기다리는 중…' : '등록이 반영되기를 기다리는 중…');
+  }
+  return { ok: false };
+}
