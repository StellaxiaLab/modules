+/** 등록 요청을 보낸다.
+ *
+ *  code는 **사람이 붙여 넣은 그대로** 보낸다 — 주소를 품은 꼴이면 그대로다. 주소를 떼어 내는 것은
+ *  Daemon의 일이고(ParseNodeEnrollCode), Master도 첫 '.' 뒤를 버리고 대조한다. 화면이 미리 떼면
+ *  코드가 품고 있던 주소가 아무 데도 실려 가지 않는다.
+ *  @param {import('./client.js').TerraClient} c
+ *  @param {{ code: string, deviceName?: string, masterUrl?: string }} input
+ *  @returns {Promise<{ ok: boolean, code?: string, msg?: string, needAddr?: boolean, data?: any }>} */
+export async function submitEnroll(c, input) {
+  const body = { code: String(input.code || '').trim() };
+  const name = String(input.deviceName || '').trim();
+  if (name) body.device_name = name;
+  const addr = String(input.masterUrl || '').trim().replace(/\/$/, '');
+  if (addr) body.master_url = addr;
+
+  // catalog를 거치지 않고 곧장 부른다. 익명 호출자의 catalog는 권한을 선언한 op를 지우므로
+  // (Gateway narrowList) 이 op는 거기에 없다 — 등록 전 창은 **한 번의 호출**을 열어 주는 것이고
+  // catalog에 보이게 하는 것이 아니다. 부를 op는 health의 enrollment.codeOperation이 알려 준다.
+  const r = await c.request('POST', '/api/v1/operations/' + encodeURIComponent(ENROLL.code.op) + '/invoke', body);
