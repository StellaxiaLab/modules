{
  "name": "terra-agent-web",
  "private": true,
  "version": "0.0.0",
  "description": "Terra Agent 화면 — 모듈 io.terra.agent 의 정적 웹 앱(빌드 결과는 ../ui)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:server": "node --test --test-timeout=60000 \"e2e/server/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
