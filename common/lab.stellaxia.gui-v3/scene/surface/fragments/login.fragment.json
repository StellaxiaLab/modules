        "alt": "TERRA",
        "width": "min(440px, 100%)",
        "a11y": {
          "role": "img",
          "label": "TERRA // LOGIN"
        }
      },
      {
        "type": "card",
        "id": "signin",
        "visible": {
          "not": {
            "store": "signin",
            "path": "/state",
            "is": {
              "const": "signedIn"
            }
          }
        },
        "children": [
          {
            "type": "text",
            "id": "prompt",
            "variant": "mono",
            "text": "○ terra login --as user"
          },
          {
            "type": "column",
            "id": "adminRow",
            "layout": "row",
            "align": "center",
            "gap": "sm",
            "children": [
              {
                "type": "text",
                "id": "adminLabel",
                "variant": "mono",
                "text": "admin    >"
              },
              {
                "type": "input",
                "id": "email",
                "placeholder": "아이디",
                "bind": {
                  "store": "signin",
                  "path": "/email"
                },
                "onChange": {
                  "function": "gui-v3.signin.field",
                  "input": {
                    "field": "email"
                  }
                },
                "a11y": {
                  "label": "아이디"
                }
              }
            ]
          },
          {
            "type": "column",
            "id": "passwordRow",
            "layout": "row",
            "align": "center",
            "gap": "sm",
            "children": [
              {
                "type": "text",
                "id": "passwordLabel",
                "variant": "mono",
                "text": "password >"
              },
              {
                "type": "input",
                "id": "password",
                "inputType": "secret",
                "placeholder": "••••••••",
                "bind": {
                  "store": "signin",
                  "path": "/password"
                },
                "onChange": {
                  "function": "gui-v3.signin.field",
                  "input": {
                    "field": "password"
                  }
                },
                "onSubmit": {
                  "function": "gui-v3.signin.submit"
                },
                "a11y": {
                  "label": "비밀번호"
                }
              }
            ]
          },
          {
            "type": "divider",
            "id": "rule"
          },
          {
            "type": "column",
            "id": "actions",
            "layout": "row",
            "align": "center",
            "justify": "between",
            "gap": "sm",
            "children": [
              {
                "type": "button",
                "id": "cancel",
                "text": "← 돌아가기",
                "onClick": {
                  "function": "gui-v3.login.close"
                },
                "a11y": {
                  "label": "로그인하지 않고 돌아가기"
                }
              },
              {
                "type": "button",
                "id": "submit",
                "text": "⏎ Login",
                "onClick": {
                  "function": "gui-v3.signin.submit"
                },
                "a11y": {
                  "label": "로그인"
                }
              }
            ]
          },
          {
            "type": "text",
            "id": "signinMessage",
            "variant": "mono",
            "bind": {
              "store": "signin",
              "path": "/message"
            },
            "empty": "",
            "a11y": {
              "role": "status",
              "live": "polite"
            }
          },
          {
            "type": "text",
            "id": "keys",
            "variant": "caption",
            "text": "enter · 로그인"
          },
          {
            "type": "text",
            "id": "signinHint",
            "variant": "caption",
            "text": "비밀번호는 게이트웨이의 Credential Service로만 갑니다."
          }
        ]
      },
      {
        "type": "card",
        "id": "session",
        "visible": {
          "store": "signin",
          "path": "/state",
          "is": {
            "const": "signedIn"
          }
        },
        "children": [
          {
            "type": "text",
            "id": "sessionPrompt",
            "variant": "mono",
            "text": "● terra login — 로그인되어 있습니다"
          },
          {
            "type": "text",
            "id": "principal",
            "variant": "mono",
            "bind": {
              "store": "signin",
              "path": "/message"
            },
            "empty": ""
          },
          {
            "type": "divider",
            "id": "sessionRule"
          },
          {
            "type": "column",
            "id": "sessionActions",
            "layout": "row",
            "align": "center",
            "justify": "between",
            "gap": "sm",
            "children": [
              {
                "type": "button",
                "id": "signout",
                "text": "로그아웃",
                "onClick": {
                  "function": "gui-v3.signout"
                }
              },
              {
                "type": "button",
                "id": "back",
                "text": "⏎ GUI 로 돌아가기",
                "onClick": {
                  "function": "gui-v3.login.close"
                },
                "a11y": {
                  "label": "GUI 로 돌아가기"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
