{
  "$schema": "../../../../../docs/contracts/api/schemas/terra-api-contract-v1.schema.json",
  "$id": "https://contracts.terra.dev/modules/lab.stellaxia.gui-v3/0.1.0/terra-api.json",
  "schemaVersion": "1.0.0",
  "contractId": "lab.stellaxia.gui-v3.api",
  "contractVersion": "0.1.0",
  "defaultLocale": "ko-KR",
  "title": "Terra GUI v3 API",
  "summary": "노드에 붙는 GUI 데이터(프로필 사진 · 노드 속성)를 저장하고 읽습니다.",
  "description": "GUI v3 의 화면은 노드 설정(terra.daemon.config.*)과 사용자 문서(terra.gateway.me.documents.*)를 직접 부릅니다. 이 계약은 그 둘로 담을 수 없는 것 — 그 노드를 보는 모든 사람에게 같아야 하는 GUI 데이터 — 만 다룹니다. 저장은 노드의 모듈 데이터 영역(TERRA_MODULE_DATA_DIR/node-data)이고, 다른 노드의 것은 그 노드의 이 모듈을 /api/nodes/<노드>/modules/lab.stellaxia.gui-v3/v1 로 부릅니다. 노드 설정을 대신 쓰는 operation 은 두지 않습니다 — 그러면 이 계약의 권한만으로 노드 설정이 바뀝니다.",
  "provider": {
    "id": "lab.stellaxia.gui-v3",
    "name": "Terra GUI v3",
    "version": "0.1.0",
    "kind": "module",
    "products": [
      "leaf",
      "tree"
    ],
    "hostRoles": [
      "leaf-node",
      "tree-control"
    ],
    "moduleId": "lab.stellaxia.gui-v3",
    "ownership": {
      "source": "common/lab.stellaxia.gui-v3",
      "team": "stellaxia-lab"
    }
  },
  "authentication": {
    "workload-identity": {
      "type": "workload-identity",
      "description": "Module Runtime이 실행 instance에 발급한 단기 Workload Identity를 사용합니다."
    }
  },
  "permissions": {
    "gui-v3.view": {
      "title": "노드 GUI 데이터 보기",
      "description": "이 노드의 프로필 사진과 GUI 속성을 읽습니다. 부수효과가 없습니다.",
      "risk": "read"
    },
    "gui-v3.customize": {
      "title": "노드 GUI 데이터 바꾸기",
      "description": "이 노드의 프로필 사진과 GUI 속성을 올리고 · 바꾸고 · 지웁니다. 그 노드를 보는 모든 사람의 화면이 바뀌므로 노드 관리자에게 줍니다.",
      "risk": "write"
    }
  },
  "errors": {
    "PATH_DENIED": {
      "title": "허용되지 않는 경로",
      "description": "경로가 노드 데이터 루트를 벗어나거나 모양이 틀렸다 — 절대 경로, 상위 이동, 점으로 시작하는 이름, 예약된 properties.json, 심볼릭 링크를 지나는 경로.",
      "retryable": false,
      "httpStatus": 400,
      "userAction": "/데이터 상대 경로로 다시 요청하십시오."
    },
    "NOT_FOUND": {
      "title": "없는 파일",
      "description": "그 경로에 저장된 파일이 없다.",
      "retryable": false,
      "httpStatus": 404,
      "userAction": "node-files.list 로 확인하십시오."
    },
    "TYPE_DENIED": {
      "title": "받지 않는 형식",
      "description": "내용이 png · jpeg · gif · webp 가 아니거나 선언한 mime 과 다르다.",
      "retryable": false,
      "httpStatus": 415,
      "userAction": "그림 파일을 올리십시오."
    },
    "TOO_LARGE": {
      "title": "한도 초과",
      "description": "파일 하나, 청크 하나, 노드 데이터 전체, 또는 속성 파일이 한도를 넘는다.",
      "retryable": false,
      "httpStatus": 413,
      "userAction": "status.get 의 한도를 확인하고 작은 파일로, 또는 청크로 나눠 보내십시오."
    },
    "CHUNK_OUT_OF_ORDER": {
      "title": "청크 순서 어긋남",
      "description": "offset 이 지금까지 받은 바이트와 다르다.",
      "retryable": true,
      "httpStatus": 409,
      "userAction": "응답의 received 를 offset 으로 이어 보내거나 offset 0 으로 다시 시작하십시오."
    },
    "INVALID_PROPERTY": {
      "title": "잘못된 속성",
      "description": "속성 키 이름이 규칙에 맞지 않거나, profile.image 가 저장된 그림을 가리키지 않는다.",
      "retryable": false,
      "httpStatus": 400,
      "userAction": "먼저 그림을 올리고 그 경로(/데이터/…)를 가리키십시오."
    },
    "INVALID_REQUEST": {
      "title": "잘못된 요청",
      "description": "요청 본문이 계약과 맞지 않는다(모르는 필드, base64 아님).",
      "retryable": false,
      "httpStatus": 400,
      "userAction": "요청을 확인하십시오."
    },
    "METHOD_NOT_ALLOWED": {
      "title": "받지 않는 메서드",
      "description": "그 경로가 이 메서드를 받지 않는다.",
      "retryable": false,
      "httpStatus": 405,
      "userAction": "계약의 bindings 를 확인하십시오."
    },
    "INTERNAL": {
      "title": "내부 오류",
      "description": "저장소를 읽거나 쓰지 못했다.",
      "retryable": true,
      "httpStatus": 500,
      "userAction": "잠시 뒤 다시 시도하고, 반복되면 모듈 로그를 확인하십시오."
    }
  },
  "operations": {
    "lab.stellaxia.gui-v3.status.get": {
      "version": "0.1.0",
      "status": "experimental",
      "title": "상태 조회",
      "summary": "GUI v3 백엔드의 상태 · 저장 용량 · 한도를 조회합니다.",
      "description": "Module Runtime의 readiness probe가 부르는 read-only operation입니다. 노드 데이터 저장소를 읽을 수 있으면 ok 입니다. 화면은 이 응답의 한도(maxFileBytes · maxChunkBytes)로 올리기를 나눕니다.",
      "category": "status",
      "tags": [
        "status",
        "health",
        "read"
      ],
      "useCases": [
        "Module Runtime이 readiness를 확인합니다.",
        "화면이 올리기 전에 파일 · 청크 한도를 읽습니다."
      ],
      "availability": {
        "products": [
          "leaf",
          "tree"
        ],
        "hostRoles": [
          "leaf-node",
          "tree-control"
        ],
        "scopes": [
          "local",
          "node"
        ],
        "requiresProviderState": "ready"
      },
      "security": {
        "authentication": [
          "workload-identity"
        ],
        "permissions": [],
        "workloadPermissions": [],
        "dataClassification": "internal",
        "audit": {
          "required": false
        }
      },
      "input": {
        "schema": {
          "type": "object",
          "additionalProperties": false
        },
        "examples": [
          {
            "name": "빈 요청",
            "value": {}
          }
        ]
      },
      "semantics": {
        "preconditions": [],
        "processing": [
          {
            "id": "read-status",
            "description": "저장소 사용량과 설정된 한도를 읽습니다.",
            "transaction": "none"
          }
        ],
        "postconditions": [],
        "sideEffects": []
      },
      "output": {
        "mode": "immediate",
        "schema": {
          "type": "object",
          "required": [
            "status",
            "version",
            "usedBytes",
            "maxFileBytes",
            "maxTotalBytes",
            "maxChunkBytes",
            "dataPrefix"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "degraded"
              ],
              "title": "상태",
              "description": "모듈의 현재 상태입니다."
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "title": "버전",
              "description": "모듈의 semantic 버전입니다."
            },
            "usedBytes": {
              "type": "integer",
              "title": "사용량",
              "description": "노드 데이터가 차지한 바이트입니다."
            },
            "maxFileBytes": {
              "type": "integer",
              "title": "파일 한도",
              "description": "파일 하나의 최대 바이트입니다(설정 maxFileMB)."
            },
            "maxTotalBytes": {
              "type": "integer",
              "title": "전체 한도",
              "description": "노드 데이터 전체의 최대 바이트입니다(설정 maxTotalMB)."
            },
            "maxChunkBytes": {
              "type": "integer",
              "title": "청크 한도",
              "description": "한 요청이 실을 수 있는 원시 바이트입니다. Gateway가 본문을 1 MiB에서 자르므로 base64 전 640 KiB입니다."
            },
            "dataPrefix": {
              "type": "string",
              "title": "데이터 접두",
              "description": "화면이 이 노드의 데이터 폴더를 부르는 이름(/데이터)입니다."
            }
          }
        },
        "examples": [
          {
            "name": "정상",
            "value": {
              "status": "ok",
              "version": "0.1.0",
              "usedBytes": 48213,
              "maxFileBytes": 8388608,
              "maxTotalBytes": 67108864,
              "maxChunkBytes": 655360,
              "dataPrefix": "/데이터"
            }
          }
        ]
      },
      "execution": {
        "risk": "read",
        "idempotency": {
          "mode": "safe"
        },
        "confirmation": {
          "mode": "none"
        },
        "timeoutMs": {
          "default": 5000,
          "maximum": 15000
        },
        "cancellation": "before-dispatch",
        "retry": {
          "mode": "safe-only",
          "maximumAttempts": 3,
          "backoff": "exponential"
        },
        "concurrency": {
          "mode": "unlimited"
        }
      },
      "bindings": [
        {
          "type": "gateway-http",
          "method": "GET",
          "path": "/api/modules/lab.stellaxia.gui-v3/v1/status",
          "successStatus": 200
        }
      ],
      "errors": [
        "INTERNAL"
      ],
      "authoring": {
        "studioVisible": false,
        "functionNode": false,
        "group": "GUI v3/Node data",
        "recommendedLabel": "상태 확인",
        "keywords": [
          "status",
          "health",
          "상태"
        ],
        "outputPorts": [
          {
            "name": "status",
            "pointer": "/status"
          }
        ]
      }
    },
