{
  "schemaVersion": 2,
  "id": "lab.stellaxia.gui-v3",
  "version": "0.3.0",
  "kind": "service",
  "name": "Terra GUI v3",
  "description": "Terra 노드 GUI 3판. 화면 설계 원본은 web/design 의 캔버스 보드이고, 웹 빌드(web/ → ui/)가 그 보드를 그대로 띄운다(씬 · 전역 틀 · 창 · 로그인, 글자 장은 GPU). 노드에 딸린 값(설정 · 모듈 · 장치 · 자원 · 작업)은 그 노드가 원본이고 화면은 사본만 든다(분할 정책 PA/EL — 끊기면 마지막 사본을 읽기 전용으로). base 가 곧장 띄우는 main GUI 다(contributions.gui.scenes[].branch \"main\") — 얇은 Scene(frame + 로그인 Route)이 같은 모듈의 embed 웹 앱(ui/index.html)을 terra.web/frame 으로 감싸고, 웹은 그 셸의 앱 토큰으로 부른다(A). 웹을 단독으로 열면 스스로 로그인한다(B, 자격 핸들 — 개발 · 시험용). 백엔드는 노드에 붙는 GUI 데이터(프로필 사진 · 노드 속성)를 모듈 데이터 영역에 두고 계약의 operation(status · node-props · node-files)으로 낸다.",
  "compatibility": {
    "products": [
      "leaf",
      "tree"
    ],
    "os": [
      "linux",
      "windows"
    ]
  },
  "entrypoints": {
    "process": {
      "linux-amd64": "bin/linux-amd64/terra-gui-v3",
      "linux-arm64": "bin/linux-arm64/terra-gui-v3",
      "windows-amd64": "bin/windows-amd64/terra-gui-v3.exe"
    },
    "scene": "scene/scene.json"
  },
  "provides": {
    "capabilities": [
      {
        "id": "lab.stellaxia.gui-v3",
        "version": "0.1.0"
      }
    ]
  },
  "contracts": {
    "api": "contracts/api/terra-api.json"
  },
  "contributions": {
    "gui": {
      "scenes": [
        {
          "id": "lab.stellaxia.gui-v3.ui",
          "entry": "scene/scene.json",
          "role": "application",
          "branch": "main"
        }
      ],
      "apps": [
        {
          "id": "lab.stellaxia.gui-v3.web",
          "name": "Terra GUI v3",
          "mode": "static",
          "entry": "ui/index.html",
          "isolation": "sandboxed",
          "embed": "scene",
          "permissions": [
            "session.identity",
            "node.read",
            "node.control",
            "node.config",
            "file.read",
            "file.write",
            "process.execute",
            "module.manage"
          ]
        }
      ]
    }
  },
  "permissions": {
    "storage": [
      "module-data"
    ]
  },
  "configuration": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFileMB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 8,
          "title": "파일 하나 한도 (MiB)",
          "description": "프로필 사진처럼 노드에 올리는 그림 하나의 최대 크기.",
          "x-terra-restart": true
        },
        "maxTotalMB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 64,
          "title": "노드 GUI 데이터 전체 한도 (MiB)",
          "description": "이 노드에 쌓이는 GUI 데이터 전체의 최대 크기.",
          "x-terra-restart": true
        }
      }
    }
  },
  "readiness": {
    "operationId": "lab.stellaxia.gui-v3.status.get",
    "versionRange": ">=0.1.0 <1.0.0",
    "timeoutMs": 15000
  },
  "update": {
    "strategy": "start-before-stop",
    "drainTimeoutMs": 30000,
    "rollback": true
  }
}
