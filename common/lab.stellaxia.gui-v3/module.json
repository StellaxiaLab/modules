{
  "schemaVersion": 2,
  "id": "lab.stellaxia.gui-v3",
  "version": "0.1.0",
  "kind": "service",
  "name": "Terra GUI v3",
  "description": "Terra 노드 GUI 3판. 화면은 설계 중(web/design 의 캔버스 원본)이고, 백엔드 1차가 들어왔다 — 노드에 붙는 GUI 데이터(프로필 사진 · 노드 속성)를 모듈 데이터 영역에 두고 계약의 operation(status · node-props · node-files)으로 낸다. 노드 설정 · 사용자 문서는 화면이 코어 operation 을 직접 부르므로 백엔드가 대신 쓰지 않는다. GUI 기여(contributions.gui)는 아직 없어 base Scene 의 목록 · main 자리에 나타나지 않는다.",
  "compatibility": {
    "products": [
      "leaf",
      "tree"
    ],
    "os": [
      "linux",
      "windows"
    ]
  },
  "entrypoints": {
    "process": {
      "linux-amd64": "bin/linux-amd64/terra-gui-v3",
      "linux-arm64": "bin/linux-arm64/terra-gui-v3",
      "windows-amd64": "bin/windows-amd64/terra-gui-v3.exe"
    },
    "scene": "scene/scene.json"
  },
  "provides": {
    "capabilities": [
      {
        "id": "lab.stellaxia.gui-v3",
        "version": "0.1.0"
      }
    ]
  },
  "contracts": {
    "api": "contracts/api/terra-api.json"
  },
  "permissions": {
    "storage": [
      "module-data"
    ]
  },
  "configuration": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFileMB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 8,
          "title": "파일 하나 한도 (MiB)",
          "description": "프로필 사진처럼 노드에 올리는 그림 하나의 최대 크기.",
          "x-terra-restart": true
        },
        "maxTotalMB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 64,
          "title": "노드 GUI 데이터 전체 한도 (MiB)",
          "description": "이 노드에 쌓이는 GUI 데이터 전체의 최대 크기.",
          "x-terra-restart": true
        }
      }
    }
  },
  "readiness": {
    "operationId": "lab.stellaxia.gui-v3.status.get",
    "versionRange": ">=0.1.0 <1.0.0",
    "timeoutMs": 15000
  },
  "update": {
    "strategy": "start-before-stop",
    "drainTimeoutMs": 30000,
    "rollback": true
  }
}
