          },
          {
            "type": "text",
            "id": "navHereHome",
            "text": "홈",
            "visible": {
              "store": "nav",
              "path": "/route",
              "is": {
                "const": "/"
              }
            },
            "a11y": {
              "label": "홈 (지금 이 화면)"
            }
          },
          {
            "type": "button",
            "id": "navHome",
            "text": "홈",
            "visible": {
