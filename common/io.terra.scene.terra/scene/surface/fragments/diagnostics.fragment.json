{
  "$comment": "Scene Fragment. 수집된 Scene·모듈 진단.\n\n손실을 **두 수치로 나눠** 내는 것이 이 화면의 요점이다. 수집기가 버린 것과 호스트가 버린 것은 서로 다른 한계이고, 합치면 어디를 고쳐야 하는지 알 수 없다.",
  "schemaVersion": "0.1.0",
  "id": "terra.diagnostics",
  "version": "0.1.0",
  "renderer": "dom.basic",
  "title": "진단",
  "stores": [
    "diagnostics",
    "session"
  ],
  "functions": [
    "terra.context.refresh",
    "terra.nav.go",
    "terra.diagnostics.refresh"
  ],
  "slots": [
    {
      "id": "shell.nav",
      "single": true
    }
  ],
  "root": {
    "type": "column",
    "id": "root",
    "gap": "lg",
    "a11y": {
      "role": "region",
      "label": "수집된 진단"
    },
    "children": [
      {
        "type": "slot",
        "id": "navSlot",
        "slot": "shell.nav"
      },
      {
        "type": "column",
        "id": "pageHead",
        "gap": "xs",
        "children": [
          {
            "type": "text",
            "id": "heading",
            "variant": "heading",
            "text": "진단"
          },
          {
            "type": "text",
            "id": "headingCaption",
            "variant": "caption",
            "text": "화면과 모듈이 올린 실패 기록. 손실 수치를 둘로 나눠 셉니다."
          }
        ]
      },
      {
        "type": "card",
        "id": "lossCard",
        "title": "버려진 진단",
        "children": [
          {
            "type": "text",
            "id": "lossNote",
            "variant": "caption",
            "text": "둘을 합치면 어디서 잃었는지 알 수 없습니다 — 수집기의 한계와 호스트의 한계는 서로 다른 문제입니다."
          },
          {
            "type": "column",
            "id": "lossTiles",
            "layout": "grid",
            "columns": 4,
            "gap": "md",
            "children": [
              {
                "type": "column",
                "id": "dropped",
                "gap": "xs",
                "children": [
                  {
                    "type": "text",
                    "id": "droppedLabel",
                    "variant": "caption",
                    "text": "수집기가 버림"
                  },
                  {
                    "type": "text",
                    "id": "droppedValue",
                    "bind": {
                      "store": "diagnostics",
                      "path": "/dropped"
                    },
                    "empty": "0"
                  }
                ]
              },
              {
                "type": "column",
                "id": "clientDropped",
                "gap": "xs",
                "children": [
                  {
                    "type": "text",
                    "id": "clientDroppedLabel",
                    "variant": "caption",
                    "text": "호스트가 버림"
                  },
                  {
                    "type": "text",
                    "id": "clientDroppedValue",
                    "bind": {
                      "store": "diagnostics",
                      "path": "/clientDropped"
                    },
                    "empty": "0"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "id": "diagnosticCard",
        "title": "올라온 진단",
        "children": [
          {
            "type": "column",
            "id": "diagnosticActions",
            "layout": "row",
            "gap": "sm",
            "align": "center",
            "children": [
              {
                "type": "button",
                "id": "refresh",
                "text": "새로 고침",
                "onClick": {
                  "function": "terra.diagnostics.refresh"
                }
              }
            ]
          },
          {
            "type": "table",
            "id": "diagnosticTable",
            "bind": {
              "store": "diagnostics",
              "path": "/items"
            },
            "empty": "올라온 진단이 없습니다",
            "a11y": {
              "role": "table",
              "label": "수집된 진단",
              "live": "polite"
            },
            "columns": [
              {
                "id": "level",
                "header": "등급",
                "path": "/level",
                "align": "center",
                "empty": "-"
              },
              {
                "id": "code",
                "header": "코드",
                "path": "/code"
              },
              {
                "id": "subject",
                "header": "대상",
                "path": "/subject",
                "empty": "-"
              },
              {
                "id": "message",
                "header": "내용",
                "path": "/message",
                "empty": "-"
              },
              {
                "id": "product",
                "header": "출처",
                "path": "/product",
                "align": "center",
                "empty": "-"
              }
            ]
          },
          {
            "type": "text",
            "id": "error",
            "variant": "caption",
            "bind": {
              "store": "diagnostics",
              "path": "/error"
            },
            "empty": "",
            "a11y": {
              "role": "alert",
              "live": "assertive"
            }
          }
        ]
      }
    ]
  },
  "triggers": [
    {
      "on": "lifecycle:enter",
      "function": "terra.context.refresh"
    },
    {
      "on": "lifecycle:enter",
      "function": "terra.diagnostics.refresh"
    }
  ]
}
