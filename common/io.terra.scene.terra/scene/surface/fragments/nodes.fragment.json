{
  "$comment": "Scene Fragment. 이 노드에서 둘러볼 수 있는 다른 노드들.\n\n통합 셸이 tree에서만 의미 있는 화면을 따로 두지 않는 방식이 이것이다: 목록은 terra.gateway.gui.remote.nodes.get이 답하는 만큼만 나오고, Master가 배선되지 않은 노드에서는 그 Operation이 501로 답해 이유가 화면에 적힌다. 화면이 제품을 묻지 않고 **노드가 답하는 대로** 그린다.",
  "schemaVersion": "0.1.0",
  "id": "terra.nodes",
  "version": "0.1.0",
  "renderer": "dom.basic",
  "title": "노드",
  "stores": [
    "remote",
    "session"
  ],
  "functions": [
    "terra.context.refresh",
    "terra.nav.go",
    "terra.remote.refresh"
  ],
  "slots": [
    {
      "id": "shell.nav",
      "single": true
    }
  ],
  "root": {
    "type": "column",
    "id": "root",
    "gap": "lg",
    "a11y": {
      "role": "region",
      "label": "원격 노드"
    },
    "children": [
      {
        "type": "slot",
        "id": "navSlot",
        "slot": "shell.nav"
      },
      {
        "type": "column",
        "id": "pageHead",
        "gap": "xs",
        "children": [
          {
            "type": "text",
            "id": "heading",
            "variant": "heading",
            "text": "노드"
          },
          {
            "type": "text",
            "id": "headingCaption",
            "variant": "caption",
            "text": "이 노드에서 둘러볼 수 있는 다른 노드들."
          }
        ]
      },
      {
        "type": "card",
        "id": "remoteCard",
        "children": [
          {
            "type": "column",
            "id": "remoteActions",
            "layout": "row",
            "gap": "sm",
            "align": "center",
            "children": [
              {
                "type": "text",
                "id": "countLabel",
                "variant": "caption",
                "text": "둘러볼 수 있는 노드"
              },
              {
                "type": "text",
                "id": "count",
                "bind": {
                  "store": "remote",
                  "path": "/count"
                },
                "empty": "0"
              },
              {
                "type": "button",
                "id": "refresh",
                "text": "새로 고침",
                "onClick": {
                  "function": "terra.remote.refresh"
                }
              }
            ]
          },
          {
            "type": "text",
            "id": "signInHint",
            "variant": "caption",
            "text": "다른 노드 목록은 node.read 권한이 있는 세션에만 보입니다.",
            "visible": {
              "not": {
                "store": "session",
                "path": "/can/nodeRead",
                "is": {
                  "const": true
                }
              }
            }
          },
          {
            "type": "table",
            "id": "nodeTable",
            "bind": {
              "store": "remote",
              "path": "/nodes"
            },
            "empty": "둘러볼 수 있는 노드가 없습니다",
            "a11y": {
              "role": "table",
              "label": "둘러볼 수 있는 노드",
              "live": "polite"
            },
            "columns": [
              {
                "id": "name",
                "header": "이름",
                "path": "/name",
                "empty": "(이름 없음)"
              },
              {
                "id": "id",
                "header": "노드 ID",
                "path": "/id"
              },
              {
                "id": "status",
                "header": "상태",
                "path": "/status",
                "align": "center",
                "empty": "unknown"
              }
            ]
          },
          {
            "type": "text",
            "id": "error",
            "variant": "caption",
            "bind": {
              "store": "remote",
              "path": "/error"
            },
            "empty": "",
            "a11y": {
              "role": "alert",
              "live": "assertive"
            }
          }
        ]
      }
    ]
  },
  "triggers": [
    {
      "on": "lifecycle:enter",
      "function": "terra.context.refresh"
    },
    {
      "on": "lifecycle:enter",
      "function": "terra.remote.refresh"
    }
  ]
}
