{
  "$comment": "Scene Fragment. 화면 설정. persistent Store 라 이 브라우저에만 남는다 — 노드의 설정이 아니다.",
  "schemaVersion": "0.1.0",
  "id": "terra.settings",
  "version": "0.1.0",
  "renderer": "dom.basic",
  "title": "설정",
  "stores": [
    "settings",
    "node",
    "session"
  ],
  "functions": [
    "terra.context.refresh",
    "terra.nav.go",
    "terra.settings.field",
    "terra.settings.save"
  ],
  "slots": [
    {
      "id": "shell.nav",
      "single": true
    }
  ],
  "root": {
    "type": "column",
    "id": "root",
    "gap": "lg",
    "a11y": {
      "role": "region",
      "label": "설정"
    },
    "children": [
      {
        "type": "slot",
        "id": "navSlot",
        "slot": "shell.nav"
      },
      {
        "type": "column",
        "id": "pageHead",
        "gap": "xs",
        "children": [
          {
            "type": "text",
            "id": "heading",
            "variant": "heading",
            "text": "설정"
          },
          {
            "type": "text",
            "id": "headingCaption",
            "variant": "caption",
            "text": "이 브라우저에만 저장되는 화면 설정."
          }
        ]
      },
      {
        "type": "card",
        "id": "viewCard",
        "title": "화면",
        "children": [
          {
            "type": "form",
            "id": "settingsForm",
            "onSubmit": {
              "function": "terra.settings.save"
            },
            "children": [
              {
                "type": "text",
                "id": "defaultRouteLabel",
                "variant": "caption",
                "text": "시작 화면"
              },
              {
                "type": "select",
                "id": "defaultRoute",
                "bind": {
                  "store": "settings",
                  "path": "/defaultRoute"
                },
                "onChange": {
                  "function": "terra.settings.field",
                  "input": {
                    "field": "defaultRoute"
                  }
                },
                "options": [
                  {
                    "value": "/",
                    "label": "홈"
                  },
                  {
                    "value": "/modules",
                    "label": "모듈"
                  },
                  {
                    "value": "/apps",
                    "label": "앱과 화면"
                  },
                  {
                    "value": "/catalog",
                    "label": "명령"
                  },
                  {
                    "value": "/nodes",
                    "label": "노드"
                  },
                  {
                    "value": "/diagnostics",
                    "label": "진단"
                  }
                ],
                "a11y": {
                  "label": "시작 화면"
                }
              },
              {
                "type": "checkbox",
                "id": "autoRefresh",
                "label": "화면에 들어갈 때 자동으로 새로 고침",
                "bind": {
                  "store": "settings",
                  "path": "/autoRefresh"
                },
                "onChange": {
                  "function": "terra.settings.field",
                  "input": {
                    "field": "autoRefresh"
                  }
                },
                "a11y": {
                  "label": "자동 새로 고침"
                }
              },
              {
                "type": "column",
                "id": "settingsActions",
                "layout": "row",
                "gap": "sm",
                "align": "center",
                "children": [
                  {
                    "type": "button",
                    "id": "save",
                    "text": "저장",
                    "onClick": {
                      "function": "terra.settings.save"
                    }
                  },
                  {
                    "type": "text",
                    "id": "saved",
                    "variant": "caption",
                    "text": "저장되었습니다.",
                    "visible": {
                      "store": "settings",
                      "path": "/saved",
                      "is": {
                        "const": true
                      }
                    },
                    "a11y": {
                      "role": "status",
                      "live": "polite"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "text",
            "id": "error",
            "variant": "caption",
            "bind": {
              "store": "settings",
              "path": "/error"
            },
            "empty": "",
            "a11y": {
              "role": "alert",
              "live": "assertive"
            }
          }
        ]
      },
      {
        "type": "card",
        "id": "aboutCard",
        "title": "이 화면에 대하여",
        "children": [
          {
            "type": "text",
            "id": "about",
            "text": "Terra 통합 Scene — leaf와 tree를 가르지 않는 하나의 GUI입니다. 모든 화면은 제품 중립 Gateway Operation만 사용하므로, 이 패키지 어디에도 이 노드가 어느 역할인지 묻는 자리가 없습니다."
          },
          {
            "type": "column",
            "id": "aboutFacts",
            "gap": "xs",
            "children": [
              {
                "type": "text",
                "id": "generationLabel",
                "variant": "caption",
                "text": "이 노드의 카탈로그 generation"
              },
              {
                "type": "text",
                "id": "generation",
                "bind": {
                  "store": "node",
                  "path": "/current/generation"
                },
                "empty": "게시되지 않음"
              }
            ]
          }
        ]
      }
    ]
  },
  "triggers": [
    {
      "on": "lifecycle:enter",
      "function": "terra.context.refresh"
    }
  ]
}
