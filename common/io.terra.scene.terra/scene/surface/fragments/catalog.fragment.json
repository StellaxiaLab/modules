{
  "$comment": "Scene Fragment. **CLI 대등성의 축이다.** 명령 목록을 화면이 들고 있지 않고 노드에게 물어서 그리므로, 모듈이 설치되면 이 화면을 고치지 않아도 그 Operation이 나타난다 — `terra api`에 어떤 모듈 id도 박혀 있지 않은 것과 같은 카탈로그다.\n\n지금은 **조회까지**다. 고른 Operation을 실행할 폼이 없는 것은 카탈로그의 input 스키마를 폼으로 만드는 수단이 어휘에 없기 때문이고(어휘 공백 ③), 그것이 373개 전부를 여는 마지막 한 칸이다.",
  "schemaVersion": "0.1.0",
  "id": "terra.catalog",
  "version": "0.1.0",
  "renderer": "dom.basic",
  "title": "명령",
  "stores": [
    "catalog",
    "session"
  ],
  "functions": [
    "terra.context.refresh",
    "terra.nav.go",
    "terra.catalog.field",
    "terra.catalog.refresh"
  ],
  "slots": [
    {
      "id": "shell.nav",
      "single": true
    }
  ],
  "root": {
    "type": "column",
    "id": "root",
    "gap": "lg",
    "a11y": {
      "role": "region",
      "label": "Operation 카탈로그"
    },
    "children": [
      {
        "type": "slot",
        "id": "navSlot",
        "slot": "shell.nav"
      },
      {
        "type": "column",
        "id": "pageHead",
        "gap": "xs",
        "children": [
          {
            "type": "text",
            "id": "heading",
            "variant": "heading",
            "text": "명령"
          },
          {
            "type": "text",
            "id": "headingCaption",
            "variant": "caption",
            "text": "이 노드가 할 줄 아는 일 전부. CLI `terra api`와 같은 목록입니다."
          }
        ]
      },
      {
        "type": "card",
        "id": "searchCard",
        "children": [
          {
            "type": "form",
            "id": "searchForm",
            "onSubmit": {
              "function": "terra.catalog.refresh"
            },
            "children": [
              {
                "type": "input",
                "id": "search",
                "placeholder": "이름이나 설명으로 찾기 (예: node, module, network)",
                "bind": {
                  "store": "catalog",
                  "path": "/query"
                },
                "onChange": {
                  "function": "terra.catalog.field"
                },
                "onSubmit": {
                  "function": "terra.catalog.refresh"
                },
                "a11y": {
                  "label": "명령 검색"
                }
              },
              {
                "type": "column",
                "id": "searchActions",
                "layout": "row",
                "gap": "sm",
                "align": "center",
                "children": [
                  {
                    "type": "button",
                    "id": "searchButton",
                    "text": "찾기",
                    "onClick": {
                      "function": "terra.catalog.refresh"
                    }
                  },
                  {
                    "type": "text",
                    "id": "countLabel",
                    "variant": "caption",
                    "text": "찾은 Operation"
                  },
                  {
                    "type": "text",
                    "id": "count",
                    "bind": {
                      "store": "catalog",
                      "path": "/count"
                    },
                    "empty": "0"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "id": "resultCard",
        "children": [
          {
            "type": "table",
            "id": "operationTable",
            "bind": {
              "store": "catalog",
              "path": "/items"
            },
            "empty": "조건에 맞는 Operation이 없습니다",
            "a11y": {
              "role": "table",
              "label": "게시된 Operation",
              "live": "polite"
            },
            "columns": [
              {
                "id": "operationId",
                "header": "Operation",
                "path": "/operationId"
              },
              {
                "id": "summary",
                "header": "하는 일",
                "path": "/summary",
                "empty": "-"
              },
              {
                "id": "category",
                "header": "분류",
                "path": "/category",
                "empty": "-"
              },
              {
                "id": "provider",
                "header": "제공",
                "path": "/providerId",
                "empty": "-"
              },
              {
                "id": "risk",
                "header": "위험도",
                "path": "/execution/risk",
                "align": "center",
                "empty": "unknown"
              }
            ]
          },
          {
            "type": "column",
            "id": "catalogFoot",
            "layout": "row",
            "gap": "sm",
            "align": "center",
            "children": [
              {
                "type": "text",
                "id": "generationLabel",
                "variant": "caption",
                "text": "generation"
              },
              {
                "type": "text",
                "id": "generation",
                "bind": {
                  "store": "catalog",
                  "path": "/generation"
                },
                "empty": "-",
                "variant": "caption"
              }
            ]
          },
          {
            "type": "text",
            "id": "error",
            "variant": "caption",
            "bind": {
              "store": "catalog",
              "path": "/error"
            },
            "empty": "",
            "a11y": {
              "role": "alert",
              "live": "assertive"
            }
          }
        ]
      }
    ]
  },
  "triggers": [
    {
      "on": "lifecycle:enter",
      "function": "terra.context.refresh"
    },
    {
      "on": "lifecycle:enter",
      "function": "terra.catalog.refresh"
    }
  ]
}
