{
  "$comment": "Scene Function. 로그인 폼 입력을 Store에 반영한다. 입력 이벤트는 이 Function만 호출하고, Store 쓰기는 여기서만 일어난다 (§11 규칙). input.field가 어느 칸인지 고른다.",
  "schemaVersion": "1.0.0",
  "id": "terra.session.field",
  "version": "0.1.0",
  "concurrency": { "mode": "parallel" },
  "graph": {
    "nodes": [
      {
        "id": "route",
        "type": "branch",
        "cases": [
          {
            "when": { "left": "$input.field", "op": "eq", "right": "password" },
            "then": [
              { "id": "savePassword", "type": "store.write", "storeId": "loginForm", "path": "/password", "value": "$input.value" }
            ]
          }
        ],
        "else": [
          { "id": "saveEmail", "type": "store.write", "storeId": "loginForm", "path": "/email", "value": "$input.value" }
        ]
      },
      { "id": "done", "type": "return", "value": "$input.value" }
    ]
  }
}
