{
  "$comment": "Scene Function. 모듈 하나를 정지한다. start와 같은 모양이고 Operation만 다르다 — 권한·감사·라우팅은 전부 Gateway가 하던 그대로다.",
  "schemaVersion": "1.0.0",
  "id": "terra.modules.stop",
  "version": "0.1.0",
  "timeoutMs": 20000,
  "concurrency": {
    "mode": "exhaust"
  },
  "graph": {
    "nodes": [
      {
        "id": "act",
        "type": "call",
        "operationId": "terra.gateway.modules.by-id.stop.post",
        "versionRange": ">=1.0.0 <2.0.0",
        "input": {
          "path": {
            "id": "$input.value"
          }
        },
        "onError": [
          {
            "id": "showError",
            "type": "store.write",
            "storeId": "modules",
            "path": "/error",
            "value": "$act.error.message"
          },
          {
            "id": "stop",
            "type": "return",
            "value": false
          }
        ]
      },
      {
        "id": "clearError",
        "type": "store.write",
        "storeId": "modules",
        "path": "/error",
        "value": ""
      },
      {
        "id": "note",
        "type": "store.write",
        "storeId": "modules",
        "path": "/notice",
        "value": {
          "module": "$input.value",
          "action": "stopped"
        }
      },
      {
        "id": "announce",
        "type": "emit",
        "signal": "terra.modules:stopped",
        "payload": "$input.value"
      },
      {
        "id": "reload",
        "type": "call",
        "operationId": "terra.gateway.gui.modules.get",
        "versionRange": ">=1.0.0 <2.0.0",
        "input": {},
        "onError": [
          {
            "id": "keepStale",
            "type": "return",
            "value": true
          }
        ]
      },
      {
        "id": "saveItems",
        "type": "store.write",
        "storeId": "modules",
        "path": "/items",
        "value": "$reload.output.modules"
      },
      {
        "id": "saveCount",
        "type": "store.write",
        "storeId": "modules",
        "path": "/count",
        "value": "$reload.output.count"
      },
      {
        "id": "done",
        "type": "return",
        "value": true
      }
    ]
  }
}
