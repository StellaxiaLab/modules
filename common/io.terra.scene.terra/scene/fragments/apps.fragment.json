{
  "$comment": "Scene Fragment. GUI 기여 전부 — 웹앱과 Scene — 를 한 화면에서 본다. 통합 셸이 자기 자신을 포함해 무엇이 base이고 무엇이 application으로 붙어 있는지 보여 주는 자리이고, 제품 base가 강등되어 앱으로 남는 것도 여기서 보인다.\n\n스캔 진단을 함께 그리는 이유는 §5.4와 같다: 기여가 거절된 것과 기여가 애초에 없는 것은 목록 밖에서 보면 똑같다.",
  "schemaVersion": "0.1.0",
  "id": "terra.apps",
  "version": "0.1.0",
  "renderer": "dom.basic",
  "title": "앱과 화면",
  "stores": ["apps", "session"],
  "functions": ["terra.nav.go", "terra.apps.refresh", "terra.scenes.refresh", "terra.app.launch"],
  "slots": [{ "id": "shell.nav", "single": true }],
  "root": {
    "type": "column",
    "id": "root",
    "gap": "md",
    "a11y": { "role": "region", "label": "설치된 GUI 기여" },
    "children": [
      { "type": "slot", "id": "navSlot", "slot": "shell.nav" },
      {
        "type": "column",
        "id": "header",
        "layout": "row",
        "gap": "sm",
        "align": "center",
        "children": [
          { "type": "text", "id": "heading", "variant": "heading", "text": "앱과 화면" },
          { "type": "button", "id": "refreshApps", "text": "앱 새로 고침", "onClick": { "function": "terra.apps.refresh" } },
          { "type": "button", "id": "refreshScenes", "text": "화면 새로 고침", "onClick": { "function": "terra.scenes.refresh" } }
        ]
      },
      { "type": "text", "id": "appsHeading", "variant": "heading", "text": "웹앱" },
      {
        "type": "list",
        "id": "appList",
        "bind": { "store": "apps", "path": "/items" },
        "empty": "설치된 웹앱이 없습니다",
        "a11y": { "role": "list", "label": "설치된 웹앱", "live": "polite" },
        "item": {
          "type": "column",
          "id": "appRow",
          "layout": "row",
          "gap": "sm",
          "align": "center",
          "children": [
            { "type": "text", "id": "appName", "itemBind": { "path": "/name" }, "empty": "(이름 없음)" },
            { "type": "text", "id": "appId", "itemBind": { "path": "/id" } },
            { "type": "text", "id": "appMode", "itemBind": { "path": "/mode" }, "empty": "static" },
            { "type": "text", "id": "appIsolation", "itemBind": { "path": "/isolation" }, "empty": "sandboxed" },
            { "type": "button", "id": "openApp", "text": "열기", "itemBind": { "path": "/id" }, "onClick": { "function": "terra.app.launch" } }
          ]
        }
      },
      { "type": "divider", "id": "split" },
      { "type": "text", "id": "scenesHeading", "variant": "heading", "text": "화면 (Scene)" },
      {
        "type": "table",
        "id": "sceneTable",
        "bind": { "store": "apps", "path": "/scenes" },
        "empty": "설치된 Scene이 없습니다",
        "a11y": { "role": "table", "label": "설치된 Scene", "live": "polite" },
        "columns": [
          { "id": "id", "header": "Scene ID", "path": "/id" },
          { "id": "module", "header": "모듈", "path": "/moduleId" },
          { "id": "role", "header": "역할", "path": "/role", "align": "center", "empty": "application" },
          { "id": "route", "header": "경로", "path": "/route", "empty": "-" }
        ]
      },
      { "type": "divider", "id": "split2" },
      { "type": "text", "id": "diagnosticsHeading", "variant": "heading", "text": "스캔 진단" },
      {
        "type": "table",
        "id": "scanDiagnostics",
        "bind": { "store": "apps", "path": "/diagnostics" },
        "empty": "거절된 기여가 없습니다",
        "a11y": { "role": "table", "label": "GUI 기여 스캔 진단", "live": "polite" },
        "columns": [
          { "id": "code", "header": "코드", "path": "/code" },
          { "id": "module", "header": "모듈", "path": "/moduleId" },
          { "id": "message", "header": "내용", "path": "/message" }
        ]
      },
      { "type": "text", "id": "error", "bind": { "store": "apps", "path": "/error" }, "empty": "", "a11y": { "role": "alert", "live": "assertive" } }
    ]
  },
  "triggers": [
    { "on": "lifecycle:enter", "function": "terra.apps.refresh" },
    { "on": "lifecycle:enter", "function": "terra.scenes.refresh" }
  ]
}
