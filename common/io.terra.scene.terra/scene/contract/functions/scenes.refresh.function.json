{
  "$comment": "Scene Function. 이 노드에 설치된 Scene 기여를 나열한다 — 통합 셸이 자기 자신을 포함해 무엇이 base이고 무엇이 application인지 보여 주는 자리다. apps와 한 parallel 노드로 묶지 않은 이유는 실패 격리다: 한쪽 실패가 다른 쪽 목록까지 지워서는 안 된다.",
  "schemaVersion": "1.0.0",
  "id": "terra.scenes.refresh",
  "version": "0.1.0",
  "timeoutMs": 5000,
  "concurrency": {
    "mode": "takeLatest"
  },
  "graph": {
    "nodes": [
      {
        "id": "request",
        "type": "call",
        "operationId": "terra.gateway.gui.scenes.get",
        "versionRange": ">=1.0.0 <2.0.0",
        "input": {},
        "onError": [
          {
            "id": "showError",
            "type": "store.write",
            "storeId": "apps",
            "path": "/error",
            "value": "$request.error.message"
          },
          {
            "id": "stop",
            "type": "return",
            "value": false
          }
        ]
      },
      {
        "id": "clearError",
        "type": "store.write",
        "storeId": "apps",
        "path": "/error",
        "value": ""
      },
      {
        "id": "save0",
        "type": "store.write",
        "storeId": "apps",
        "path": "/scenes",
        "value": "$request.output.scenes"
      },
      {
        "id": "announce",
        "type": "emit",
        "signal": "terra.scenes:refreshed",
        "payload": "$request.output.count"
      },
      {
        "id": "done",
        "type": "return",
        "value": "$request.output.count"
      }
    ]
  }
}
