{
  "$comment": "Scene Function. 런처가 열 수 있는 웹앱을 나열한다. 인증을 요구하지 않으므로 로그인 전에도 목록이 선다. 스캔 진단을 함께 받아 두는 이유는 §5.4와 같다 — 기여가 거절된 것과 기여가 애초에 없는 것은 밖에서 보면 똑같다.",
  "schemaVersion": "1.0.0",
  "id": "terra.apps.refresh",
  "version": "0.1.0",
  "timeoutMs": 5000,
  "concurrency": {
    "mode": "takeLatest"
  },
  "graph": {
    "nodes": [
      {
        "id": "request",
        "type": "call",
        "operationId": "terra.gateway.gui.apps.get",
        "versionRange": ">=1.0.0 <2.0.0",
        "input": {},
        "onError": [
          {
            "id": "showError",
            "type": "store.write",
            "storeId": "apps",
            "path": "/error",
            "value": "$request.error.message"
          },
          {
            "id": "stop",
            "type": "return",
            "value": false
          }
        ]
      },
      {
        "id": "clearError",
        "type": "store.write",
        "storeId": "apps",
        "path": "/error",
        "value": ""
      },
      {
        "id": "save0",
        "type": "store.write",
        "storeId": "apps",
        "path": "/items",
        "value": "$request.output.apps"
      },
      {
        "id": "save1",
        "type": "store.write",
        "storeId": "apps",
        "path": "/count",
        "value": "$request.output.count"
      },
      {
        "id": "save2",
        "type": "store.write",
        "storeId": "apps",
        "path": "/diagnostics",
        "value": "$request.output.diagnostics"
      },
      {
        "id": "announce",
        "type": "emit",
        "signal": "terra.apps:refreshed",
        "payload": "$request.output.count"
      },
      {
        "id": "done",
        "type": "return",
        "value": "$request.output.count"
      }
    ]
  }
}
