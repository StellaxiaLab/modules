{
  "$comment": "Scene Function. 둘러볼 수 있는 원격 노드를 나열한다. 이 Operation은 호출자 토큰으로 Master에 가므로 로그인 전에는 403이고, 그것이 맞다 — 판단할 근거가 없는 것과 볼 것이 없는 것은 다른 답이다. 그래서 실패를 화면의 error에 적고 목록은 비워 둔다.",
  "schemaVersion": "1.0.0",
  "id": "terra.remote.refresh",
  "version": "0.1.0",
  "timeoutMs": 8000,
  "concurrency": {
    "mode": "takeLatest"
  },
  "graph": {
    "nodes": [
      {
        "id": "request",
        "type": "call",
        "operationId": "terra.gateway.gui.remote.nodes.get",
        "versionRange": ">=1.0.0 <2.0.0",
        "input": {},
        "onError": [
          {
            "id": "showError",
            "type": "store.write",
            "storeId": "remote",
            "path": "/error",
            "value": "$request.error.message"
          },
          {
            "id": "stop",
            "type": "return",
            "value": false
          }
        ]
      },
      {
        "id": "clearError",
        "type": "store.write",
        "storeId": "remote",
        "path": "/error",
        "value": ""
      },
      {
        "id": "save0",
        "type": "store.write",
        "storeId": "remote",
        "path": "/nodes",
        "value": "$request.output.nodes"
      },
      {
        "id": "save1",
        "type": "store.write",
        "storeId": "remote",
        "path": "/count",
        "value": "$request.output.count"
      },
      {
        "id": "announce",
        "type": "emit",
        "signal": "terra.remote:refreshed",
        "payload": "$request.output.count"
      },
      {
        "id": "done",
        "type": "return",
        "value": "$request.output.count"
      }
    ]
  }
}
