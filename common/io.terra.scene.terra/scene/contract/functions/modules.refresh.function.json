{
  "$comment": "Scene Function. 이 노드에 설치된 모듈을 나열한다. terra.gateway.gui.modules.get은 GUI를 기여하지 않는 모듈까지 포함한 인벤토리라서, 런처의 관리 패널이 읽어야 하는 것이 정확히 이것이다. 개수는 게이트웨이가 이미 세어 보내므로 여기서 다시 세지 않는다 — array.count를 얹으면 같은 답을 두 자리에서 만들게 되고, 응답이 비었을 때 그 노드가 던진다.",
  "schemaVersion": "1.0.0",
  "id": "terra.modules.refresh",
  "version": "0.1.0",
  "timeoutMs": 5000,
  "concurrency": {
    "mode": "takeLatest"
  },
  "graph": {
    "nodes": [
      {
        "id": "request",
        "type": "call",
        "operationId": "terra.gateway.gui.modules.get",
        "versionRange": ">=1.0.0 <2.0.0",
        "input": {},
        "onError": [
          {
            "id": "showError",
            "type": "store.write",
            "storeId": "modules",
            "path": "/error",
            "value": "$request.error.message"
          },
          {
            "id": "stop",
            "type": "return",
            "value": false
          }
        ]
      },
      {
        "id": "clearError",
        "type": "store.write",
        "storeId": "modules",
        "path": "/error",
        "value": ""
      },
      {
        "id": "save0",
        "type": "store.write",
        "storeId": "modules",
        "path": "/items",
        "value": "$request.output.modules"
      },
      {
        "id": "save1",
        "type": "store.write",
        "storeId": "modules",
        "path": "/count",
        "value": "$request.output.count"
      },
      {
        "id": "announce",
        "type": "emit",
        "signal": "terra.modules:refreshed",
        "payload": "$request.output.count"
      },
      {
        "id": "done",
        "type": "return",
        "value": "$request.output.count"
      }
    ]
  }
}
